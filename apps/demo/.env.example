# Copy to apps/demo/.env. Never commit the real file.

# Nebius Token Factory key: https://tokenfactory.nebius.com/
NEBIUS_API_KEY=
# Model id from the Token Factory Models page (a Nemotron model).
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# OpenAI-compatible endpoint (this is the default).
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Optional: enables the webSearch tool.
# TAVILY_API_KEY=

# Optional: require "Authorization: Bearer <value>" on POST /turn.
# DEMO_TOKEN=

# Server binds to 127.0.0.1 only.
PORT=8787
# Config file, relative to the repo root.
NEMOKON_CONFIG=config.example.yaml
